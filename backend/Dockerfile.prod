FROM python:3.11-alpine3.24

WORKDIR /app

ENV PIP_PREFER_BINARY=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1 \
    PYTHONUNBUFFERED=1

# Apply stable-distribution security updates newer than the Python image.
# su-exec lets the entrypoint drop root after fixing media ownership.
RUN apk upgrade --no-cache \
  && apk add --no-cache su-exec \
  && addgroup -S -g 10001 app \
  && adduser -S -D -H -u 10001 -G app app

COPY backend/requirements.txt /tmp/requirements.txt

RUN python -m pip install --upgrade pip setuptools wheel \
  && python -m pip install --only-binary=:all: --no-binary=http-ece -r /tmp/requirements.txt \
  && python -m pip check \
  && python -m pip uninstall -y pip setuptools wheel \
  && python -c 'import ensurepip,pathlib,shutil; shutil.rmtree(pathlib.Path(ensurepip.__file__).parent)'

COPY backend/ /app/

ENTRYPOINT ["/app/docker-entrypoint.sh"]
# No access log: room sockets carry their credentials in the URL (browsers can't set
# WebSocket headers), and uvicorn logs the full query string. The app's own
# request.complete line logs the path only.
CMD ["sh", "-c", "uvicorn app.main:app --host 0.0.0.0 --port 8000 --workers ${UVICORN_WORKERS:-2} --no-access-log"]
