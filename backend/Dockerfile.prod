FROM python:3.11-slim

WORKDIR /app

ENV PIP_PREFER_BINARY=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1 \
    PYTHONUNBUFFERED=1

COPY backend/requirements.txt /tmp/requirements.txt

# torch from the CPU-only index first: the default wheels carry the CUDA runtime,
# gigabytes this host has no GPU to use. The requirements then resolve against it.
ARG TORCH_INDEX_URL=https://download.pytorch.org/whl/cpu

RUN python -m pip install --upgrade pip setuptools wheel \
  && pip install --default-timeout=1200 --retries=10 --index-url "$TORCH_INDEX_URL" \
       "$(grep -E '^torch==' /tmp/requirements.txt)" \
  && pip install --default-timeout=1200 --retries=10 -r /tmp/requirements.txt

COPY backend/ /app/

CMD ["sh", "-c", "uvicorn app.main:app --host 0.0.0.0 --port 8000 --workers ${UVICORN_WORKERS:-2}"]
