#!/bin/sh
# Refuses a commit that adds a secret; the repo is public. Turn on once per clone:
#   git config core.hooksPath .githooks
if ! command -v gitleaks >/dev/null 2>&1; then
  echo "pre-commit: gitleaks isn't installed (brew install gitleaks); only CI will scan." >&2
  exit 0
fi
exec gitleaks git --pre-commit --staged --config .gitleaks.toml --redact --no-banner .
