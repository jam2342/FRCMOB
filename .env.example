# FRCMOB local configuration. Copy to .env; never commit real values.
APP_ENV=development
DATABASE_URL=postgresql+psycopg://localhost:5432/frc
DATABASE_URL_DOCKER=postgresql+psycopg://postgres:postgres@postgres:5432/frc
REDIS_URL=redis://localhost:6379/0

# Generate both values independently, for example: openssl rand -hex 32
ADMIN_API_KEY=
ADMIN_SESSION_TOKEN_SECRET=
ADMIN_API_HEADER=X-Admin-Key
ADMIN_SESSION_TTL_SEC=7200
SCOUTING_ROOM_ACCESS_TTL_SEC=43200
PUBLIC_READONLY_MODE=false
ENFORCE_ADMIN_AUTH_FOR_WRITES=true
STRICT_STARTUP_ENV_VALIDATION=false

CORS_ALLOW_ORIGINS=http://localhost:5173,http://localhost:3000
LOG_LEVEL=INFO
LOG_FORMAT=text

# Optional integrations. Features degrade gracefully when keys are absent.
TBA_AUTH_KEY=
FIRST_FRC_API_USERNAME=
FIRST_FRC_API_AUTH_KEY=
FIRST_FRC_API_BASE_URL=https://frc-api.firstinspires.org/v3.0
STATBOTICS_BASE_URL=https://api.statbotics.io/v3

# Model artifacts are not distributed in this repository.
VIDEO_TRACKING_YOLO_MODEL=media/models/frc_robot_detector_v2.pt
VIDEO_TRACKING_YOLO_MODEL_URL=
VIDEO_TRACKING_YOLO_MODEL_SHA256=
VIDEO_TRACKING_REQUIRE_PRIMARY_MODEL_IN_PRODUCTION=true
VIDEO_TRACKING_REQUIRE_PRIMARY_MODEL_SHA256_IN_PRODUCTION=true

# Optional web push. Keep the private key server-side.
PUSH_NOTIFICATIONS_ENABLED=false
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# Frontend build variables belong in ScoutingApp/.env.local (also ignored).
# VITE_API_URL=http://localhost:8000
# VITE_WS_URL=ws://localhost:8000
# VITE_ONDEVICE_MODEL_URL=https://example.com/frc_robot_detector_v2.onnx
