{
  "name": "scoutingapp",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build": "tsc -b && vite build",
    "dev": "vite",
    "guard": "npm run guard:colours && npm run guard:type && npm run guard:hierarchy && npm run guard:boxes && npm run guard:consistency && npm run guard:contrast && npm run guard:overflow && npm run guard:affordances",
    "guard:affordances": "node e2e/guard-affordances.mjs",
    "guard:boxes": "node e2e/guard-boxes.mjs",
    "guard:colours": "node e2e/guard-colours.mjs",
    "guard:consistency": "node e2e/guard-consistency.mjs",
    "guard:contrast": "node e2e/guard-contrast.mjs",
    "guard:hierarchy": "node e2e/guard-hierarchy.mjs",
    "guard:overflow": "node e2e/guard-overflow.mjs",
    "guard:type": "node e2e/guard-type.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "probe:heroes": "node e2e/probe-conditional-heroes.mjs",
    "test": "vitest run",
    "validate:on-device-browser": "node e2e/validate-on-device.mjs",
    "test:watch": "vitest",
    "build:native": "tsc -b && vite build --mode native && node scripts/validate-native-bundle.mjs",
    "native:sync": "npm run build:native && cap sync",
    "native:ios": "npm run native:sync && cap open ios",
    "native:android": "npm run native:sync && cap open android",
    "native:doctor": "node scripts/native-doctor.mjs",
    "native:build:android": "npm run native:sync && node scripts/native-android-build.mjs",
    "native:bundle:android": "npm run native:sync && node scripts/native-android-build.mjs --release",
    "brand:assets": "node scripts/brand-assets.mjs",
    "native:build:ios": "npm run build:native && cap sync ios && node scripts/native-ios-build.mjs",
    "native:build:ios:probe": "npm run build:native && cap sync ios && node scripts/native-ios-build.mjs --probe",
    "validate:ui-stress": "node e2e/stress-ui.mjs",
    "validate:user-errors": "node e2e/stress-user-errors.mjs",
    "validate:workspace-recording": "node e2e/validate-workspace-recording.mjs",
    "native:archive:ios": "npm run build:native && cap sync ios && node scripts/native-ios-build.mjs --archive",
    "native:bundle:android:signed": "npm run native:sync && node scripts/native-android-build.mjs --release --signed",
    "native:beta:doctor": "node scripts/native-beta-doctor.mjs"
  },
  "dependencies": {
    "@capacitor/android": "8.5.2",
    "@capacitor/app": "8.1.2",
    "@capacitor/browser": "8.0.4",
    "@capacitor/core": "8.5.2",
    "@capacitor/filesystem": "8.1.3",
    "@capacitor/ios": "8.5.2",
    "@capacitor/share": "8.0.2",
    "@techstark/opencv-js": "^4.5.2",
    "@vercel/analytics": "^2.0.1",
    "mp4box": "^2.4.1",
    "onnxruntime-web": "^1.27.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.2",
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^26.6.4",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.13.0",
    "jsdom": "^30.1.1",
    "playwright": "^1.60.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.0.0-beta.13",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "vite": "^8.0.0-beta.13",
    "xcode": {
      "uuid": "11.1.1"
    }
  }
}
