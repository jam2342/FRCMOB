# Root context is used by docker-compose.prod.yml / aws / oci builds.
# Ignore everything by default, then include only what those Dockerfiles copy.
*

!backend/
!backend/**

# Exclude heavy and non-runtime backend artifacts. Runtime media (pit photos, ML
# shadow models) lives in the backend_media volume, not the image.
backend/media/
backend/manual_videos/
backend/*.pt
backend/tests/
backend/docs/
backend/__pycache__/
backend/.pytest_cache/
backend/.ruff_cache/
backend/.mypy_cache/
backend/.venv/
backend/venv/
backend/.env
backend/.env.*
backend/*.log
