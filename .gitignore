# On-device ONNX model blobs. Only the shipped detector is tracked: Vercel deploys from
# git, so an untracked model means production silently has no on-device detection.
# It is export-ignored (.gitattributes) so the public repo sync never carries weights.
ScoutingApp/public/models/*
*.onnx
!ScoutingApp/public/models/frc_robot_detector_v4_s.onnx
!ScoutingApp/public/models/frc_robot_detector_v4_n.onnx

# Native bundles are generated by npm run native:sync, never committed.
ScoutingApp/dist-native/
.venv/
